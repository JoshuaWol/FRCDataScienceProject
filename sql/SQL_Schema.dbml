// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Table Districts{
  districtkey varchar [not null, pk]
  districtCode varchar
  districtName varchar
}

Table TeamInfo {
  teamKey integer  [not null, pk]
  teamNumber integer
  nameFull varchar
  nameShort varchar
  districtCode varchar [ref: > Districts.districtCode]
  rookieYear integer
  city varchar
  stateProv varchar
  country varchar
}


Table Events {
  eventKey varchar [not null, pk]
  year integer [not null]
  event varchar
  eventType varchar 
  date date
  location varchar
  Webcast varchar
  weekNumber integer
  districtKey varchar [ref: > Districts.districtkey]
}


table MatchTable {
  matchKey varchar [not null, pk, unique]
  eventKey varchar [not null, ref: > Events.eventKey]
  year integer
  matchLevel varchar
}


Table MatchTeams {
  matchKey integer [not null, ref: > MatchTable.matchKey]
  teamKey integer [not null, ref: > TeamInfo.teamKey ]
  alliance varchar [not null]
  
  indexes {
    (matchKey, teamKey) [pk, unique] // composite PK
  }
}


Table MatchData2026 {
  matchKey integer [ not null, ref: > MatchTable.matchKey]
  alliance integer  [not null]
  totalScore  integer
  teleopCount integer
  autoScore integer
  shift1Points integer
  shift2Points integer
  shift3Points integer
  shift4Points integer
  endgamePoints integer
  autoTowerPoints integer
  totalAutoPoints integer
  endgameTowerPoints integer
  totalTowerPoints integer
  minorFoulCount integer
  majorFoulCount integer
  foulPoints integer
  adjustPoins integer
  RP integer

  indexes {
    (matchKey, alliance) [pk, unique] //composite pk
  }
}





